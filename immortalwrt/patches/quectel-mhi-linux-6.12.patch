From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: EchoWrt maintainers <129679838+ECHOAPi@users.noreply.github.com>
Date: Fri, 28 Aug 2026 00:00:00 +0000
Subject: [PATCH] quectel_MHI: adapt core driver to Linux 6.12

Linux 6.12 removed no_llseek and made bus_type.match's driver argument
const. Update the out-of-tree MHI driver for both API changes.

---
 src/core/mhi_init.c | 7 ++++---
 1 file changed, 4 insertions(+), 3 deletions(-)

diff --git a/src/core/mhi_init.c b/src/core/mhi_init.c
--- a/src/core/mhi_init.c
+++ b/src/core/mhi_init.c
@@ -645,6 +645,6 @@ static const struct file_operations mon_fops_text_u = {
 	.owner =	THIS_MODULE,
 	.open =		mon_text_open,
-	.llseek =	no_llseek,
+	.llseek =	noop_llseek,
 	.read =		mon_text_read_u,
 	.release =	mon_text_release,
 };
@@ -2369,10 +2369,11 @@ void mhi_unprepare_after_power_down(struct mhi_controller *mhi_cntrl)
 }
 
 /* match dev to drv */
-static int mhi_match(struct device *dev, struct device_driver *drv)
+static int mhi_match(struct device *dev, const struct device_driver *drv)
 {
 	struct mhi_device *mhi_dev = to_mhi_device(dev);
-	struct mhi_driver *mhi_drv = to_mhi_driver(drv);
+	const struct mhi_driver *mhi_drv =
+		container_of(drv, const struct mhi_driver, driver);
 	const struct mhi_device_id *id;
 
 	/* if controller type there is no client driver associated with it */
